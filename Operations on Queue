#include<stdio.h>
#define MAX 100
int queue[MAX],front=-1,rear=-1;
int isfull(){
return rear==MAX-1;
}
int isempty(){
return front==-1;
}
void enqueue(int n){
if(isfull()){
    printf("overflow");
    return ;
}
queue[++rear]=n;
if(front==-1){
    front=rear;
}
printf("element inserted\n");
}
int dequeue(){
if(isempty()){
    printf("UNDERFLOW\n");
    return -1;
}
else{int x=queue[front++];
if(front>rear){
    front=rear=-1;
}
return x;}
}
int peek(){
    if(isempty()){
        printf("queue is empty\n");
        return -1;
    }
else{return queue[front];
}}
void display(){
 if(isempty()){
        printf("queue is empty\n");
        return;
    }

    for(int i=front;i<=rear;i++){
        printf("%d ",queue[i]);
    }
    printf("\n");
}
int main(){
    int ch,n,y,x;
    while(1){
    printf("choose operation:\n");
    printf("1.ENQUEUE\n");
     printf("2.DEQUEUE\n");
      printf("3.PEEK\n");
       printf("4.DISPLAY\n");
    scanf("%d",&ch);
    switch(ch){
        case 1:
        printf("Enter number:\n");
        scanf("%d",&n);
        enqueue(n);
        break;
        case 2:
        x = dequeue();
    if(x != -1)
        printf("%d is removed from queue\n", x);
    break;
        case 3:
       y = peek();
    if(y != -1)
        printf("%d is at front of the queue\n", y);
    break;
        case 4:
        display();
        break;
        default:
        printf("INVALID CHOICE\n");
    }}
    return 0;
}

#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main(){
    int n;
    scanf("%d", &n);
    int s[n],t[n];
    int count1=0,count2=0;
    for(int i=0;i<n;i++){
        scanf("%d", &s[i]);
        if(s[i]==0)
            count1++;
        else
            count2++;
    }
    for(int i=0;i<n;i++){
        scanf("%d", &t[i]);
        if(t[i]==0){
            if(count1==0)
                break;
            count1--;
        }
        else{
            if(count2==0)
                break;
            count2--;
        }
    }
    printf("%d", count1+count2);
    return 0;
}

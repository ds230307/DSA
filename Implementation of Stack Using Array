#include<stdio.h>
#include<stdlib.h>
#define MAX 100
int stack[MAX], top=-1;
int isEmpty(){
    return top == -1;
}
int isFull(){
    return top == MAX-1;
}
void push(int value){   // add value at the top
    if(isFull())
        printf("\nStack Overflow.Can't add new elements.!!\n");
    else{
        stack[++top] = value;
        printf("Pushed %d into the stack\n", value);
    }
}
int pop(){    // remove value from the top
    if(isEmpty()){
        printf("Stack Underflow!!\n");
        return -1;
    }
    else{
        int val = stack[top];
        top--;
        return val;
    }
}
int peek(){
    if(isEmpty()){
        printf("Stack Underflow!!\n");
        return -1;
    }
    else
        return stack[top];
}
void show(){    // there is no such operation. it is just to check the stack.
    if(isEmpty())
        printf("\n Stack is Empty!!!\n");
    else{
        printf("Stack elements are:\n");
        for(int i=top; i>=0; i--){
            printf("%d\n", stack[i]);
        }
    }
}
int main(){
int res,val;
while(1){
printf("1. Push\n");
printf("2. Pop\n");
printf("3. Peek\n");
printf("4. Show\n");
printf("5. Exit\n");
int choice, value, pos;
        printf("Enter Choice:");
        scanf("%d", &choice);
        switch(choice){
            case 1:
                printf("Enter value:");
                scanf("%d", &value);
                push(val);
                break;
            case 2:
                res = pop();
                if(res!=-1)
                printf("\n%d pop from the stack.\n", res);
                break;
            case 3:
                res = peek;
                if(res!=-1)
                printf("\n %d is available at top of the Stack.\n", res);
                break;
            case 4:
                show();
                break;
            case 5:
               exit(0);
                break;
            default:
                printf("\nInvalid Choice!!!\n");
        }
    }
    return 0;
}

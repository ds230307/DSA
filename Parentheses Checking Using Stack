#include<stdio.h>
#include<string.h>
int main (){
    char str[100];
    printf("Enter Expression: ");
    gets(str);
    int len = strlen(str), top = -1;
    char stack[len];
    for(int i = 0; i < len; i++) {
    if(str[i] == '(' || str[i] == '{' || str[i] == '[') {
        stack[++top] = str[i];
        printf("Balanced\n");
        return 0;
    }
    else if(str[i] == ')' || str[i] == '}' || str[i] == ']') {
        if(top == -1) {
            printf("Not Balanced\n");
            return 0;
        }
        if((str[i] == ')' && stack[top] == '(') ||
           (str[i] == '}' && stack[top] == '{') ||
           (str[i] == ']' && stack[top] == '[')) {
            top--;  
        }
        else {
            printf("Not Balanced\n");
            return 0;
        }
    }
}
    return 0;
}
